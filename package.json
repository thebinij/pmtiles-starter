{
  "name": "pmtiles-starter",
  "description": "Example project showing how to convert GeoJSON to PMTiles and use them with MapLibre GL instead of raw GeoJSON.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "labels": "node scripts/build-world-labels.mjs",
    "tiles": "node scripts/build-tiles.mjs",
    "test:regions": "node scripts/test-regions.mjs",
    "upload:tiles": "node scripts/upload-tiles.mjs",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "pmtiles": "^4.4.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "polylabel": "^2.0.1",
    "svelte": "^5.33.0",
    "vite": "^6.3.5",
    "wrangler": "^4.14.0"
  }
}
